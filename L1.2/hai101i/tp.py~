def uneEtape(t):
    t2 = [0]*len(t)
    for i in range(len(t)):
        if i!=0 and i!=len(t)-1:
            if t[i+1]==t[i-1]:
                t2[i]=t[i+1]
        elif i==0:
            t2[i]=t[i+1]
        elif i==len(t)-1:
            t2[i]=t[i-1]
    return t2
                
