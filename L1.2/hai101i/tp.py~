def exMult11(a,b):
    if a>=b:
        if a%11!=0:
            return False
        else:
            return True
    if a%11==0:
        return True
    else:
       return exMult11(a+1,b)

def maxMult11(a,b):
    if not exMult11(a,b):
        return -1
    else:
        if b%11==0:
            return b
        else:
            return maxMult11(a,b-1)

            
def nbMult11(a,b):
    if not exMult11(a,b):
        return 0
    else:
        if a%11==0:
            return 1+nbMult11(a+1,b)
        else:
            return nbMult11(a+1,b)

def somMult11(a,b):
    if not exMult11(a,b):
        return 0
    else:
        if a%11==0:
            return a+somMult11(a+1,b)
        else:
            return somMult11(a+1,b)
def nbChifDec(n):
    if n==0:
        return 0
    else:
        return 1+nbChifDec(n//10)

def binaire(n):
    if n==0:
        return "0"
    if n==1:
        return "1"
    else:
        if n%2==0:
            return binaire(n//2)+"0"
        else:
            return binaire(n//2)+"1"


